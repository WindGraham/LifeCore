<?xml version="1.0" encoding="utf-8"?>
<com.google.android.material.card.MaterialCardView xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent" android:layout_height="wrap_content"
    android:layout_margin="6dp" app:contentPadding="12dp" app:cardElevation="2dp">
    <LinearLayout android:layout_width="match_parent" android:layout_height="wrap_content" android:orientation="vertical">
        <TextView android:id="@+id/jobName" android:layout_width="match_parent" android:layout_height="wrap_content" android:textSize="15sp" android:textStyle="bold" />
        <TextView android:id="@+id/jobMeta" android:layout_width="match_parent" android:layout_height="wrap_content"
            android:textSize="11sp" android:textColor="#888" android:layout_marginTop="2dp" />
        <LinearLayout android:layout_width="match_parent" android:layout_height="wrap_content" android:orientation="horizontal" android:layout_marginTop="6dp">
            <Button android:id="@+id/btnRun" android:layout_width="0dp" android:layout_height="wrap_content" android:layout_weight="1" android:text="立即执行" style="@style/Widget.Material3.Button.TextButton" />
            <Button android:id="@+id/btnPause" android:layout_width="0dp" android:layout_height="wrap_content" android:layout_weight="1" android:text="暂停/恢复" style="@style/Widget.Material3.Button.TextButton" />
            <Button android:id="@+id/btnDel" android:layout_width="0dp" android:layout_height="wrap_content" android:layout_weight="1" android:text="删除" style="@style/Widget.Material3.Button.TextButton" />
        </LinearLayout>
    </LinearLayout>
</com.google.android.material.card.MaterialCardView>
