<?xml version="1.0" encoding="utf-8"?>
<androidx.swiperefreshlayout.widget.SwipeRefreshLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:id="@+id/swipe" android:layout_width="match_parent" android:layout_height="match_parent">
    <ScrollView android:layout_width="match_parent" android:layout_height="match_parent" android:padding="16dp">
        <LinearLayout android:layout_width="match_parent" android:layout_height="wrap_content" android:orientation="vertical">
            <TextView android:id="@+id/gwStatus" android:layout_width="match_parent" android:layout_height="wrap_content"
                android:textSize="14sp" android:lineSpacingMultiplier="1.3" android:layout_marginBottom="8dp" />
            <TextView android:id="@+id/deviceInfo" android:layout_width="match_parent" android:layout_height="wrap_content"
                android:textSize="13sp" android:textColor="#888" android:layout_marginBottom="16dp" />
            <EditText android:id="@+id/baseUrlInput" android:layout_width="match_parent" android:layout_height="wrap_content"
                android:hint="服务器地址" android:inputType="textUri" />
            <com.google.android.material.button.MaterialButton android:id="@+id/btnSaveUrl"
                android:layout_width="match_parent" android:layout_height="wrap_content" android:text="保存地址" android:layout_marginBottom="8dp" />
            <com.google.android.material.button.MaterialButton android:id="@+id/btnChOverride"
                android:layout_width="match_parent" android:layout_height="wrap_content" android:text="频道级 prompt / 回复意向" android:layout_marginBottom="8dp" />
            <com.google.android.material.button.MaterialButton android:id="@+id/btnEditMcp"
                android:layout_width="match_parent" android:layout_height="wrap_content" android:text="MCP 能力管理" android:layout_marginBottom="8dp" />
            <com.google.android.material.button.MaterialButton android:id="@+id/btnEditConfig"
                android:layout_width="match_parent" android:layout_height="wrap_content" android:text="网关配置（高级 JSON）" android:layout_marginBottom="8dp" />
            <com.google.android.material.button.MaterialButton android:id="@+id/btnLogout"
                android:layout_width="match_parent" android:layout_height="wrap_content" android:text="退出登录"
                style="@style/Widget.Material3.Button.OutlinedButton" />
        </LinearLayout>
    </ScrollView>
</androidx.swiperefreshlayout.widget.SwipeRefreshLayout>
