<?xml version="1.0" encoding="utf-8"?>
<FrameLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent" android:layout_height="wrap_content"
    android:paddingStart="48dp" android:paddingEnd="12dp" android:paddingTop="4dp" android:paddingBottom="4dp">
    <TextView android:id="@+id/msgContent" android:layout_width="wrap_content" android:layout_height="wrap_content"
        android:layout_gravity="end" android:background="@drawable/bubble_user"
        android:textColor="?attr/colorOnPrimaryContainer" android:textSize="15sp"
        android:lineSpacingMultiplier="1.25" android:textIsSelectable="true" android:elevation="1dp" />
</FrameLayout>
