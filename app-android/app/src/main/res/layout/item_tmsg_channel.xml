<?xml version="1.0" encoding="utf-8"?>
<!-- v0.3 通道事件气泡：左侧 + 通道名 chip + 左侧 3dp 灰条 -->
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent" android:layout_height="wrap_content"
    android:orientation="horizontal"
    android:paddingStart="12dp" android:paddingEnd="48dp" android:paddingTop="4dp" android:paddingBottom="4dp"
    android:gravity="start">
    <View
        android:layout_width="3dp"
        android:layout_height="match_parent"
        android:layout_marginEnd="8dp"
        android:background="@color/lc_outline" />
    <LinearLayout android:layout_width="wrap_content" android:layout_height="wrap_content"
        android:maxWidth="280dp" android:orientation="vertical" android:background="@drawable/bubble_channel">
        <TextView android:id="@+id/msgContent" android:layout_width="wrap_content" android:layout_height="wrap_content"
            android:maxWidth="280dp" android:textColor="?attr/colorOnSurface" android:textSize="14sp"
            android:lineSpacingMultiplier="1.2" android:textIsSelectable="true" />
        <TextView android:id="@+id/msgChannel" android:layout_width="wrap_content" android:layout_height="wrap_content"
            android:layout_marginTop="6dp" android:textSize="11sp"
            android:textColor="?attr/colorOnSurface"
            android:background="@drawable/bg_pill_primary"
            android:paddingHorizontal="8dp" android:paddingVertical="2dp" />
        <TextView android:id="@+id/msgTime" android:layout_width="wrap_content" android:layout_height="wrap_content"
            android:textSize="11sp" android:textColor="?attr/colorOnSurfaceVariant"
            android:gravity="end" android:layout_marginTop="4dp" />
    </LinearLayout>
</LinearLayout>
