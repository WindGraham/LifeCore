<?xml version="1.0" encoding="utf-8"?>
<androidx.swiperefreshlayout.widget.SwipeRefreshLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:id="@+id/swipe" android:layout_width="match_parent" android:layout_height="match_parent">
    <ScrollView android:layout_width="match_parent" android:layout_height="match_parent">
        <LinearLayout android:layout_width="match_parent" android:layout_height="wrap_content"
            android:orientation="vertical" android:padding="12dp">

            <!-- 顶部 4 个小数字（counters） -->
            <com.google.android.material.card.MaterialCardView
                android:layout_width="match_parent" android:layout_height="wrap_content"
                android:layout_marginBottom="12dp" app:cardElevation="0dp" app:strokeWidth="1dp"
                app:strokeColor="?attr/colorOutlineVariant" app:contentPadding="14dp">
                <LinearLayout android:layout_width="match_parent" android:layout_height="wrap_content"
                    android:orientation="horizontal" android:weightSum="4">
                    <LinearLayout
                        android:layout_width="0dp" android:layout_height="wrap_content"
                        android:layout_weight="1" android:orientation="vertical"
                        android:gravity="center_horizontal">
                        <TextView android:id="@+id/cntEvents" android:layout_width="wrap_content"
                            android:layout_height="wrap_content" android:textSize="22sp"
                            android:textStyle="bold" android:textColor="?attr/colorPrimary" />
                        <TextView android:layout_width="wrap_content" android:layout_height="wrap_content"
                            android:textSize="11sp" android:textColor="?attr/colorOnSurfaceVariant"
                            android:text="今日事件" />
                    </LinearLayout>
                    <LinearLayout android:layout_width="0dp" android:layout_height="wrap_content"
                        android:layout_weight="1" android:orientation="vertical"
                        android:gravity="center_horizontal">
                        <TextView android:id="@+id/cntThreads" android:layout_width="wrap_content"
                            android:layout_height="wrap_content" android:textSize="22sp"
                            android:textStyle="bold" android:textColor="?attr/colorPrimary" />
                        <TextView android:layout_width="wrap_content" android:layout_height="wrap_content"
                            android:textSize="11sp" android:textColor="?attr/colorOnSurfaceVariant"
                            android:text="活跃议题" />
                    </LinearLayout>
                    <LinearLayout android:layout_width="0dp" android:layout_height="wrap_content"
                        android:layout_weight="1" android:orientation="vertical"
                        android:gravity="center_horizontal">
                        <TextView android:id="@+id/cntFeedback" android:layout_width="wrap_content"
                            android:layout_height="wrap_content" android:textSize="22sp"
                            android:textStyle="bold" android:textColor="?attr/colorPrimary" />
                        <TextView android:layout_width="wrap_content" android:layout_height="wrap_content"
                            android:textSize="11sp" android:textColor="?attr/colorOnSurfaceVariant"
                            android:text="等你回应" />
                    </LinearLayout>
                    <LinearLayout android:layout_width="0dp" android:layout_height="wrap_content"
                        android:layout_weight="1" android:orientation="vertical"
                        android:gravity="center_horizontal">
                        <TextView android:id="@+id/cntDecision" android:layout_width="wrap_content"
                            android:layout_height="wrap_content" android:textSize="22sp"
                            android:textStyle="bold" android:textColor="?attr/colorPrimary" />
                        <TextView android:layout_width="wrap_content" android:layout_height="wrap_content"
                            android:textSize="11sp" android:textColor="?attr/colorOnSurfaceVariant"
                            android:text="等你决策" />
                    </LinearLayout>
                </LinearLayout>
            </com.google.android.material.card.MaterialCardView>

            <!-- 卡片 A：今日已发生 -->
            <com.google.android.material.card.MaterialCardView
                android:layout_width="match_parent" android:layout_height="wrap_content"
                android:layout_marginBottom="12dp"
                app:cardElevation="0dp" app:strokeWidth="1dp"
                app:strokeColor="?attr/colorOutlineVariant"
                app:contentPadding="14dp">
                <LinearLayout android:layout_width="match_parent" android:layout_height="wrap_content"
                    android:orientation="vertical">
                    <TextView android:layout_width="wrap_content" android:layout_height="wrap_content"
                        android:text="A · 今日已发生"
                        android:textStyle="bold" android:textSize="15sp"
                        android:textColor="?attr/colorPrimary" android:layout_marginBottom="6dp" />
                    <androidx.recyclerview.widget.RecyclerView
                        android:id="@+id/cardARv"
                        android:layout_width="match_parent" android:layout_height="wrap_content"
                        android:nestedScrollingEnabled="false" />
                    <TextView android:id="@+id/cardAEmpty" android:layout_width="match_parent"
                        android:layout_height="wrap_content" android:text="今日还没有事项"
                        android:textSize="13sp" android:textColor="?attr/colorOnSurfaceVariant"
                        android:visibility="gone" android:padding="6dp" />
                </LinearLayout>
            </com.google.android.material.card.MaterialCardView>

            <!-- 卡片 B：等你回应 -->
            <com.google.android.material.card.MaterialCardView android:id="@+id/cardBWrap"
                android:layout_width="match_parent" android:layout_height="wrap_content"
                android:layout_marginBottom="12dp"
                app:cardElevation="2dp" app:contentPadding="16dp">
                <LinearLayout android:layout_width="match_parent" android:layout_height="wrap_content"
                    android:orientation="vertical">
                    <TextView android:layout_width="wrap_content" android:layout_height="wrap_content"
                        android:text="B · 等你回应"
                        android:textStyle="bold" android:textSize="15sp"
                        android:textColor="?attr/colorPrimary" android:layout_marginBottom="6dp" />
                    <androidx.recyclerview.widget.RecyclerView android:id="@+id/cardBRv"
                        android:layout_width="match_parent" android:layout_height="wrap_content"
                        android:nestedScrollingEnabled="false" />
                    <TextView android:id="@+id/cardBEmpty" android:layout_width="match_parent"
                        android:layout_height="wrap_content" android:text="没有等你回应的事项"
                        android:textSize="13sp" android:textColor="?attr/colorOnSurfaceVariant"
                        android:padding="6dp" />
                </LinearLayout>
            </com.google.android.material.card.MaterialCardView>

            <!-- 卡片 C：想问你的 -->
            <com.google.android.material.card.MaterialCardView android:id="@+id/cardCWrap"
                android:layout_width="match_parent" android:layout_height="wrap_content"
                android:layout_marginBottom="12dp"
                app:cardElevation="0dp" app:strokeWidth="1dp"
                app:strokeColor="?attr/colorOutlineVariant"
                app:contentPadding="14dp">
                <LinearLayout android:layout_width="match_parent" android:layout_height="wrap_content"
                    android:orientation="vertical">
                    <TextView android:layout_width="wrap_content" android:layout_height="wrap_content"
                        android:text="C · 想问你的"
                        android:textStyle="bold" android:textSize="15sp"
                        android:textColor="?attr/colorPrimary" android:layout_marginBottom="6dp" />
                    <androidx.recyclerview.widget.RecyclerView android:id="@+id/cardCRv"
                        android:layout_width="match_parent" android:layout_height="wrap_content"
                        android:nestedScrollingEnabled="false" />
                    <TextView android:id="@+id/cardCEmpty" android:layout_width="match_parent"
                        android:layout_height="wrap_content" android:text="agent 没什么想问你的"
                        android:textSize="13sp" android:textColor="?attr/colorOnSurfaceVariant"
                        android:padding="6dp" />
                </LinearLayout>
            </com.google.android.material.card.MaterialCardView>

            <!-- 卡片 D：想问点什么（用户输入区） -->
            <com.google.android.material.card.MaterialCardView
                android:layout_width="match_parent" android:layout_height="wrap_content"
                app:cardElevation="0dp" app:strokeWidth="1dp"
                app:strokeColor="?attr/colorOutlineVariant"
                app:contentPadding="14dp">
                <LinearLayout android:layout_width="match_parent" android:layout_height="wrap_content"
                    android:orientation="vertical">
                    <TextView android:layout_width="wrap_content" android:layout_height="wrap_content"
                        android:text="D · 你想问点什么"
                        android:textStyle="bold" android:textSize="15sp"
                        android:textColor="?attr/colorPrimary" android:layout_marginBottom="8dp" />
                    <LinearLayout android:id="@+id/chipChips"
                        android:layout_width="match_parent" android:layout_height="wrap_content"
                        android:orientation="horizontal" android:layout_marginBottom="8dp" />
                    <LinearLayout android:layout_width="match_parent" android:layout_height="wrap_content"
                        android:orientation="horizontal" android:gravity="center_vertical">
                        <EditText android:id="@+id/inputD"
                            android:layout_width="0dp" android:layout_height="wrap_content"
                            android:layout_weight="1"
                            android:hint="例如：那封邮件回了没有？"
                            android:inputType="text" android:maxLines="2" />
                        <com.google.android.material.button.MaterialButton android:id="@+id/btnSendD"
                            android:layout_width="wrap_content" android:layout_height="wrap_content"
                            android:layout_marginStart="8dp" android:text="发送" />
                    </LinearLayout>
                </LinearLayout>
            </com.google.android.material.card.MaterialCardView>

        </LinearLayout>
    </ScrollView>
</androidx.swiperefreshlayout.widget.SwipeRefreshLayout>
