<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent" android:layout_height="wrap_content"
    android:orientation="vertical" android:gravity="center_horizontal"
    android:paddingHorizontal="24dp" android:paddingVertical="6dp">
    <TextView android:id="@+id/msgContent"
        android:layout_width="wrap_content" android:layout_height="wrap_content"
        android:textSize="11sp" android:textColor="?attr/colorOnSurfaceVariant"
        android:textStyle="italic" android:gravity="center" />
    <TextView android:id="@+id/msgTime"
        android:layout_width="wrap_content" android:layout_height="wrap_content"
        android:textSize="10sp" android:textColor="?attr/colorOnSurfaceVariant"
        android:layout_marginTop="2dp" />
</LinearLayout>
