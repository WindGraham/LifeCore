<?xml version="1.0" encoding="utf-8"?>
<!-- v0.3 续报气泡：左侧 + 黄色警告 + 左侧 3dp 警告色条 -->
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent" android:layout_height="wrap_content"
    android:orientation="horizontal"
    android:paddingStart="12dp" android:paddingEnd="48dp" android:paddingTop="4dp" android:paddingBottom="4dp"
    android:gravity="start">
    <View
        android:layout_width="3dp"
        android:layout_height="match_parent"
        android:layout_marginEnd="8dp"
        android:background="@color/lc_warning" />
    <LinearLayout android:layout_width="wrap_content" android:layout_height="wrap_content"
        android:maxWidth="280dp" android:orientation="vertical" android:background="@drawable/bubble_resume">
        <TextView android:id="@+id/msgContent" android:layout_width="wrap_content" android:layout_height="wrap_content"
            android:maxWidth="280dp" android:textColor="?attr/colorOnSurface" android:textSize="15sp"
            android:lineSpacingMultiplier="1.25" android:textIsSelectable="true" />
        <TextView android:id="@+id/msgTime" android:layout_width="wrap_content" android:layout_height="wrap_content"
            android:textSize="11sp" android:textColor="@color/lc_warning"
            android:gravity="end" android:layout_marginTop="4dp" />
    </LinearLayout>
</LinearLayout>
